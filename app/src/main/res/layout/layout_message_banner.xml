<!--
Wrapper layout to inset more easily.
Parent layout may apply padding for nav bar, so don't clip to avoid cutting off shadow.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:clipToPadding="false"
    tools:ignore="UnusedAttribute"
    tools:showIn="@layout/fragment_display_rv">

    <!-- Margin should be bigger than elevation so shadows have enough space to draw -->
    <LinearLayout
        style="@style/Widget.WpDisplay.MessageBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:elevation="6dp"
        android:orientation="horizontal"
        tools:ignore="UnusedAttribute">

        <TextView
            android:id="@+id/textViewMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="3"
            android:paddingStart="24dp"
            android:paddingTop="@dimen/padding_large"
            android:paddingBottom="@dimen/padding_large"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            tools:ignore="RtlSymmetry"
            tools:text="@string/message_no_connection_permission" />

        <Button
            android:id="@+id/buttonAction"
            style="@style/Widget.WpDisplay.MessageBanner.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp"
            tools:text="@string/action_retry" />

    </LinearLayout>

</FrameLayout>
